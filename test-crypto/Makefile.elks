# ELKS build for mathtest — a standalone curve25519 scalarmult benchmark.
#
# Builds a small ia16 a.out binary from src/curve25519.c plus mathtest.c
# and just enough ELKS libc.  Deploy with:
#     make -f Makefile.elks
#     cp mathtest /srv/ftp/mathtest      # or however you transfer
# and on ELKS:
#     time mathtest
#
# Runs in seconds instead of a full SSH KEX in minutes — useful for
# iterating on Phase 2 assembly changes.

TOPDIR ?= ..

CC = ia16-elf-gcc
OBJDIR = obj-elks
BINARY = mathtest

CPPFLAGS = -I . -I $(TOPDIR)/src -I $(TOPDIR)/libtomcrypt/src/headers \
	-DDROPBEAR_CURVE25519_DEP=1 -DDROPBEAR_ED25519=0

# Match the flags used in the main Makefile.elks so mathtest timings are
# a valid proxy for ssh's crypto path.
CFLAGS = -mcmodel=medium -melks-libc -mtune=i8086 -Wall -O2 \
	-fomit-frame-pointer -fno-strict-overflow -Wno-pointer-sign

SRCS = mathtest.c curve25519.c

OBJS = $(addprefix $(OBJDIR)/,$(SRCS:.c=.o))

.PHONY: all clean

all: $(BINARY)

$(BINARY): $(OBJS)
	$(CC) -mcmodel=medium -melks-libc -mtune=i8086 -maout-heap=24576 -maout-stack=4096 -o $@ $(OBJS)

$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

clean:
	rm -rf $(OBJDIR) $(BINARY)
