# ELKS build for mathtest — a standalone Curve25519 / Ed25519 benchmark.
#
# Builds a small ia16 a.out binary from src/curve25519.c (compiled with
# the same dropbear options as `ssh`: X25519 + Ed25519 verify), the 8086
# field asm, libtomcrypt's SHA-512, and mathtest.c.  Deploy with
# ~/elks-local/push-mathtest.sh, then on ELKS:
#     time mathtest          # both;  `mathtest x` / `mathtest e` for one
#
# Runs in a couple of minutes instead of a full SSH KEX — useful for
# iterating on field-arithmetic changes.

# dropbear86 root; not TOPDIR, which ELKS env.sh exports as the ELKS tree
DBDIR = ..

CC = ia16-elf-gcc
OBJDIR = obj-elks
BINARY = mathtest

# Match the main Makefile.elks so timings are a valid proxy for ssh.
CFLAGS = -mcmodel=medium -melks-libc -mtune=i8086 -Wall -O2 \
	-fomit-frame-pointer -fno-strict-overflow -Wno-pointer-sign
# Dropbear's real headers and options for the shipped code ...
DB_CPPFLAGS = -I $(DBDIR) -I $(DBDIR)/src -I $(DBDIR)/libtomcrypt/src/headers \
	-DLOCALOPTIONS_H_EXISTS -DDROPBEAR_CLIENT -DDROPBEAR_ELKS_WEAK_RANDOM=1
# ... plus stage marks inside Ed25519 verify (see PROFILE_MARK).
CURVE_CPPFLAGS = $(DB_CPPFLAGS) -DCURVE25519_PROFILE

LTC_SRCS = hashes/sha2/sha512 misc/crypt/crypt_argchk

OBJS = $(OBJDIR)/mathtest.o $(OBJDIR)/curve25519.o $(OBJDIR)/fe25519_ia16.o \
	$(addprefix $(OBJDIR)/ltc/,$(addsuffix .o,$(LTC_SRCS)))

GUARD = $(DBDIR)/default_options_guard.h

.PHONY: all clean

all: $(BINARY)

$(BINARY): $(OBJS)
	$(CC) -mcmodel=medium -melks-libc -mtune=i8086 -maout-heap=24576 -maout-stack=4096 -o $@ $(OBJS)

$(GUARD):
	$(MAKE) -C $(DBDIR) -f Makefile.elks default_options_guard.h

$(OBJDIR)/mathtest.o: mathtest.c ed25519_vectors.h curve25519.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -I . -c $< -o $@

$(OBJDIR)/curve25519.o: $(DBDIR)/src/curve25519.c $(GUARD) $(DBDIR)/localoptions.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(CURVE_CPPFLAGS) -c $< -o $@

$(OBJDIR)/fe25519_ia16.o: $(DBDIR)/src/fe25519_ia16.S
	@mkdir -p $(dir $@)
	$(CC) -mcmodel=medium -melks-libc -c $< -o $@

$(OBJDIR)/ltc/%.o: $(DBDIR)/libtomcrypt/src/%.c $(GUARD) $(DBDIR)/localoptions.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(DB_CPPFLAGS) -c $< -o $@

clean:
	rm -rf $(OBJDIR) $(BINARY)
