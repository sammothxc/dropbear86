TOPDIR ?= ../..

CC = ia16-elf-gcc
OBJDIR = obj-elks
SVR_OBJDIR = obj-elks-svr
DBCLIENT = ssh
DBSERVER = sshd

BASE_CPPFLAGS = -I. -I src -I libtomcrypt/src/headers -DLOCALOPTIONS_H_EXISTS -DDROPBEAR_ELKS_WEAK_RANDOM=1
CPPFLAGS = $(BASE_CPPFLAGS) -DDROPBEAR_CLIENT
SVR_CPPFLAGS = $(BASE_CPPFLAGS) -DDROPBEAR_SERVER
# -O2 works on QEMU (verified end-to-end KEX). Earlier hang on real Compaq
# hardware turned out to be heap sizing, not compiler codegen — once the
# heap dropped from 40 KB to 24 KB, -Os ran fine and -O2 remains untested
# on real 8086 as of last iteration. Keep at -O2 for the ~5% speedup; if
# a future test shows -O2 broken on the Compaq, fall back to -Os.
CFLAGS = -mcmodel=medium -melks-libc -mtune=i8086 -Wall -O2 \
	-fomit-frame-pointer -fno-strict-overflow -Wno-pointer-sign

# Shared by ssh and sshd, but compiled separately for each: the common
# code checks IS_DROPBEAR_CLIENT / IS_DROPBEAR_SERVER at compile time.
COMMON_SRCS = \
	dbutil buffer dbhelpers signkey dbrandom queue atomicio compat fake-rfc2553 \
	ltc_prng crypto_desc curve25519 ed25519 dbmalloc common-session packet \
	common-algo common-kex common-channel common-chansession termcodes \
	loginrec listener process-packet common-runopts circbuffer list netio \
	chachapoly kex-x25519

CLI_SRCS = \
	cli-main cli-auth cli-authpasswd cli-authpubkey \
	cli-kex cli-session cli-runopts cli-chansession cli-channel cli-authinteract

SVR_SRCS = \
	svr-kex svr-auth sshpty svr-authpasswd svr-authpubkey svr-authpubkeyoptions \
	svr-session svr-service svr-chansession svr-runopts svr-agentfwd svr-main \
	svr-x11fwd svr-tcpfwd svr-authpam tcp-accept

DBCLIENT_SRCS = $(COMMON_SRCS) $(CLI_SRCS)
DBSERVER_SRCS = $(COMMON_SRCS) $(SVR_SRCS)

LTC_SRCS = \
	hashes/sha2/sha256 hashes/sha2/sha512 hashes/helper/hash_memory \
	mac/hmac/hmac_init mac/hmac/hmac_process mac/hmac/hmac_done \
	mac/poly1305/poly1305 misc/base64/base64_encode misc/base64/base64_decode \
	misc/crypt/crypt_argchk misc/crypt/crypt_find_hash \
	misc/crypt/crypt_hash_descriptor misc/crypt/crypt_hash_is_valid \
	misc/crypt/crypt_register_hash misc/zeromem \
	stream/chacha/chacha_setup stream/chacha/chacha_ivctr64 \
	stream/chacha/chacha_crypt stream/chacha/chacha_keystream

# Hand-written 8086 field arithmetic for curve25519.c (generated from
# src/fe25519_ia16.py; the .S is committed so no Python is needed here).
ASM_SRCS = fe25519_ia16

DBCLIENT_OBJS = $(addprefix $(OBJDIR)/,$(addsuffix .o,$(DBCLIENT_SRCS) $(ASM_SRCS)))
LTC_OBJS = $(addprefix $(OBJDIR)/ltc/,$(addsuffix .o,$(LTC_SRCS)))
DBSERVER_OBJS = $(addprefix $(SVR_OBJDIR)/,$(addsuffix .o,$(DBSERVER_SRCS) $(ASM_SRCS)))
SVR_LTC_OBJS = $(addprefix $(SVR_OBJDIR)/ltc/,$(addsuffix .o,$(LTC_SRCS)))

# Build identity for `ssh -V`.  Regenerated every make but only rewritten
# when the commit (or dirty state) changes, so it doesn't force rebuilds.
DB86_VERSION := $(shell git describe --always --dirty 2>/dev/null || echo unknown)

.PHONY: all clean FORCE

all: $(DBCLIENT)

$(DBCLIENT): default_options_guard.h $(DBCLIENT_OBJS) $(LTC_OBJS)
	$(CC) -mcmodel=medium -melks-libc -mtune=i8086 -maout-heap=24576 -maout-stack=4096 -o $@ $(DBCLIENT_OBJS) $(LTC_OBJS)

$(DBSERVER): default_options_guard.h $(DBSERVER_OBJS) $(SVR_LTC_OBJS)
	$(CC) -mcmodel=medium -melks-libc -mtune=i8086 -maout-heap=24576 -maout-stack=4096 -o $@ $(DBSERVER_OBJS) $(SVR_LTC_OBJS)

default_options_guard.h: src/default_options.h src/ifndef_wrapper.sh
	@printf "/*\n > > > Do not edit this file (default_options_guard.h) < < <\nGenerated from src/default_options.h\nLocal customisation goes in localoptions.h\n*/\n\n" > $@.tmp
	@./src/ifndef_wrapper.sh < src/default_options.h >> $@.tmp
	@mv $@.tmp $@

dropbear86_version.h: FORCE
	@echo '#define DROPBEAR86_VERSION "$(DB86_VERSION)"' > $@.tmp
	@cmp -s $@.tmp $@ && rm -f $@.tmp || mv $@.tmp $@

$(OBJDIR)/curve25519.o: CPPFLAGS += -DCURVE25519_PHASE_MARKS
$(SVR_OBJDIR)/curve25519.o: SVR_CPPFLAGS += -DCURVE25519_PHASE_MARKS

$(OBJDIR)/common-runopts.o $(SVR_OBJDIR)/common-runopts.o: dropbear86_version.h
$(OBJDIR)/common-runopts.o: CPPFLAGS += -include dropbear86_version.h
$(SVR_OBJDIR)/common-runopts.o: SVR_CPPFLAGS += -include dropbear86_version.h

$(OBJDIR)/%.o: src/%.c default_options_guard.h localoptions.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

$(OBJDIR)/%.o: src/%.S
	@mkdir -p $(dir $@)
	$(CC) -mcmodel=medium -melks-libc -c $< -o $@

$(OBJDIR)/ltc/%.o: libtomcrypt/src/%.c default_options_guard.h localoptions.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

# sshd's code doesn't fit ELKS's default near/far split (see
# src/elks_place.sh), so place it explicitly: the shared transport and
# crypto code in the far segment, server code and libtomcrypt near.
SVR_PLACE = near
$(addprefix $(SVR_OBJDIR)/,$(addsuffix .o,$(COMMON_SRCS) $(ASM_SRCS))): SVR_PLACE = far

$(SVR_OBJDIR)/%.o: src/%.c default_options_guard.h localoptions.h src/elks_place.sh
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(SVR_CPPFLAGS) -c $< -o $@
	sh src/elks_place.sh $(SVR_PLACE) $@

$(SVR_OBJDIR)/%.o: src/%.S src/elks_place.sh
	@mkdir -p $(dir $@)
	$(CC) -mcmodel=medium -melks-libc -c $< -o $@
	sh src/elks_place.sh $(SVR_PLACE) $@

$(SVR_OBJDIR)/ltc/%.o: libtomcrypt/src/%.c default_options_guard.h localoptions.h src/elks_place.sh
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(SVR_CPPFLAGS) -c $< -o $@
	sh src/elks_place.sh $(SVR_PLACE) $@

clean:
	rm -rf $(OBJDIR) $(SVR_OBJDIR) $(DBCLIENT) $(DBSERVER) default_options_guard.h dropbear86_version.h
